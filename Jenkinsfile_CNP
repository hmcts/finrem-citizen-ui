#!groovy

import uk.gov.hmcts.contino.GithubAPI

@Library("Infrastructure@2.5.1")

def type = "nodejs"
def product = "finrem"
def component = "citizen-ui"
def defaultCcdDataStoreApiUrl = "http://ccd-data-store-api-aat.service.core-compute-aat.internal"

def yarnBuilder = new uk.gov.hmcts.contino.YarnBuilder(this)

def secrets = [
  'finrem-${env}': [
    secret("finrem-citizen-s2s-client-secret", "SERVICE_AUTH_SECRET"),
    secret("finrem-citizen-ui-idam-client-secret", "FINREM_CITIZEN_UI_IDAM_CLIENT_SECRET"),
    // Caseworker credentials for case creation
    secret("fr-caseworker-username", "USERNAME_CASEWORKER"),
    secret("fr-caseworker-password", "PASSWORD_CASEWORKER"),
    // Solicitor credentials for case submission
    secret("playwright-solicitor-username", "PLAYWRIGHT_SOLICITOR_USERNAME"),
    secret("playwright-solicitor-password", "PLAYWRIGHT_SOLICITOR_PSWD"),
    // System user for citizen case lookup
    secret("finrem-system-update-username", "IDAM_SYSTEM_USERNAME"),
    secret("finrem-system-update-password", "IDAM_SYSTEM_PASSWORD")
  ]
]

static LinkedHashMap<String, Object> secret(String secretName, String envVar) {
  [ $class: 'AzureKeyVaultSecret',
    secretType: 'Secret',
    name: secretName,
    version: '',
    envVariable: envVar
  ]
}

def resolveCcdDefinitionsPr = {
  def githubApi = new GithubAPI(this)

  for (label in githubApi.getLabelsbyPattern(env.BRANCH_NAME, 'use-ccd-defs-pr-')) {
    return label.minus('use-ccd-defs-pr-').trim()
  }

  return ''
}

def resolvePreviewCcdUrl = {
  String ccdDefinitionsPr = resolveCcdDefinitionsPr()
  if (!ccdDefinitionsPr) {
    return defaultCcdDataStoreApiUrl
  }

  return "https://ccd-data-store-api-finrem-ccd-definitions-pr-${ccdDefinitionsPr}.preview.platform.hmcts.net"
}

withPipeline(type, product, component) {
  // test:coverage executes unit + route tests via jest.config roots.
  env.UNIT_TESTS_COMMAND = "yarn test:coverage && yarn lint && yarn test:api"

  loadVaultSecrets(secrets)

  afterSuccess('build') {
    yarnBuilder.yarn('build')
  }
  // 2. Setup for Smoke and Functional Tests
  before('tests') {
    sh 'rm -rf smoke-output functional-output a11y-output'
    sh 'yarn playwright install --with-deps chromium'
  }

  afterAlways('smokeTest') {
    junit testResults: 'smoke-output/smoke-test-results.xml', allowEmptyResults: true
    archiveArtifacts artifacts: 'smoke-output/**', allowEmptyArchive: true
  }

  afterAlways('functionalTest:preview') {
    junit testResults: 'functional-output/functional-test-result.xml', allowEmptyResults: true
    archiveArtifacts artifacts: 'functional-output/**', allowEmptyArchive: true
  }

  enableSlackNotifications('#finrem-dev')
  enableAksStagingDeployment()
  disableLegacyDeployment()

  onMaster() {
    env.JENKINS_BRANCH = "master"
    env.RUNNING_ENV = "aat"
    env.CCD_URL = defaultCcdDataStoreApiUrl
  }

  onPR() {
    // Optional backend PR override for preview CI:
    // GitHub label on the frontend PR -> use-ccd-defs-pr-1234
    // Routes CCD_URL to ccd-data-store-api-finrem-ccd-definitions-pr-1234.preview.platform.hmcts.net

    env.JENKINS_BRANCH = "preview"
    env.RUNNING_ENV = "pr-${CHANGE_ID}"
    env.TEST_URL = "https://finrem-citizen-ui-pr-${CHANGE_ID}.preview.platform.hmcts.net"
    env.CCD_URL = resolvePreviewCcdUrl()
  }
}
