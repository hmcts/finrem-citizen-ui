{% from "./macros/getting-help.njk" import gettingHelp %}

{% extends "template.njk" %}

{% set pageTitle = "Dashboard" %}

{% block content %}
  <h2 class="govuk-heading-l">{{ userName or 'Your financial remedy case' }}</h2>
  <p class="govuk-body">Case number {{ (caseNumber | formatCaseNumber) or 'Not available' }}</p>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible finrem-section-break">

      {% if hasDivorceCase %}
        <div class="govuk-inset-text finrem-dashboard-inset--highlight">
          <h2 class="govuk-heading-m">This is your financial remedy account</h2>
          <p class="govuk-body">
            If you want to view your divorce case you can
            <a href="https://www.apply-divorce.service.gov.uk/" class="govuk-link" target="_blank" rel="noopener noreferrer">go to your divorce account (opens in new tab)</a>.
          </p>
        </div>
      {% endif %}

      <h2 class="govuk-heading-m">Latest information</h2>

      {% if latestCaseUpdateTemplate %}
        {% include "./partials/dashboard/latest-case-update/" + latestCaseUpdateTemplate + ".njk" %}
      {% endif %}

      <br>
      {% if showPreviouslyUploaded %}
        <p class="govuk-body">
          <a href="/upload/previously-uploaded-documents" class="govuk-link">View previously uploaded documents</a>
        </p>
      {% endif %}
    </div>

    <div class="govuk-grid-column-one-third">
      <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible finrem-section-break">

      <h2 class="govuk-heading-m govuk-!-padding-top-2">I want to...</h2>

      <p class="govuk-body">
        <a href="https://www.gov.uk/government/collections/financial-remedy-forms" class="govuk-link" target="_blank" rel="noopener noreferrer">Find templates for the most commonly requested documents (opens in new tab)</a>
      </p>

      <p class="govuk-body">
        <a href="https://www.gov.uk/guidance/what-to-expect-coming-to-a-court-or-tribunal" class="govuk-link" target="_blank" rel="noopener noreferrer">Find out what to expect coming to a court (opens in new tab)</a>
      </p>

      <p class="govuk-body">
        <a href="https://www.advicenow.org.uk/get-help/family-and-children/going-family-court" class="govuk-link" target="_blank" rel="noopener noreferrer">Read advice about representing myself in court from AdviceNow (opens in new tab)</a>
      </p>

      <p class="govuk-body">
        <a href="https://www.judiciary.uk/wp-content/uploads/2026/03/020326-Preparing-Court-Bundles-for-Family-Proceedings-Guide-for-Litigants-in-Person.pdf" class="govuk-link" target="_blank" rel="noopener noreferrer">Read advice about preparing a court bundle from Judiciary UK (opens in new tab)</a>
      </p>

      <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">

      {{ gettingHelp(contactEmail) }}
    </div>
  </div>
{% endblock %}
