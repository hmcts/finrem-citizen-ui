{% macro gettingHelp(contactEmail, contactDetails) %}

<aside class="govuk-prototype-kit-common-templates-related-items" role="complementary">
  <h2 class="govuk-heading-s govuk-!-margin-top-9" id="subsection-title">
    Getting help
  </h2>
  <details class="govuk-details" data-module="govuk-details">
    <summary class="govuk-details__summary">
      <span class="govuk-details__summary-text">
        Contact us for help
      </span>
    </summary>
    <div class="govuk-details__text">
      <h3 class="govuk-heading-s">Email</h3>
      <p class="govuk-body">
        <a href="mailto:{{ contactEmail or contactDetails.defaultEmail }}" class="govuk-link">{{ contactEmail or contactDetails.defaultEmail }}</a>
      </p>
      
      <h3 class="govuk-heading-s">Telephone</h3>
      <p class="govuk-body">
        {{ contactDetails.phoneNumber }}<br>
        {{ contactDetails.openingHours }}
      </p>
      
      <p class="govuk-body">
        <a href="{{ contactDetails.callChargesUrl }}" class="govuk-link" target="_blank" rel="noopener noreferrer">
          {{ contactDetails.callChargesText }}
        </a>
      </p>
    </div>
  </details>
</aside>

{% endmacro %}
