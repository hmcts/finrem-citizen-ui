{% from "../macros/getting-help.njk" import gettingHelp %}
{% from "../macros/form-submit-button.njk" import formSubmitButton %}
{% from "../macros/form.njk" import form with context %}

{% extends "template.njk" %}

{% set pageTitle = "Before you start" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if previousStep %}
        <a href="/upload/{{ previousStep }}" class="govuk-back-link govuk-!-margin-top-0 govuk-!-margin-bottom-6">Back</a>
      {% else %}
        <a href="/dashboard" class="govuk-back-link govuk-!-margin-top-0 govuk-!-margin-bottom-6">Back</a>
      {% endif %}

      <h1 class="govuk-heading-l">{{ pageTitle }}</h1>

      <p class="govuk-body">You should:</p>

      <ul class="govuk-list govuk-list--bullet">
        <li>check the court order you have received</li>
        <li>prepare all the documents the court order says you must send to the court</li>
      </ul>

      <h2 class="govuk-heading-m">Naming your documents</h2>

      <p class="govuk-body">
        To help the court identify and assess your documents, make sure you name them appropriately,
        for example, [name]-bankstatement-[month][year].
      </p>

      <p class="govuk-body">
        Some of your documents may be automatically renamed when you upload them. 
        We will tell you if your documents will be renamed as you upload them.
      </p>

      <h2 class="govuk-heading-m">After you have submitted</h2>

      <p class="govuk-body">
        Once you have uploaded your documents, they will be added to your case file and the court
        will be able to view them. You will receive an email confirmation that they have been added
        to your case.
      </p>

      <p class="govuk-body">
        You will be able to view any documents you have uploaded on your online account.
      </p>

      <p class="govuk-body">
        You must send the documents you upload here to the other party, or their solicitor if they have one. Parties cannot see the other’s documents on their online account, and the court will not normally send documents for you. Please refer to your court order for more detail.
      </p>

      <details class="govuk-details" data-module="govuk-details">
        <summary class="govuk-details__summary">
          <span class="govuk-details__summary-text">
            I am not able to send documents to the other party
          </span>
        </summary>
        <div class="govuk-details__text">
          You must email the court as soon as possible if you are not able to send the documents to 
          the other party. This could be because you do not have their contact details, there is a court order in place preventing contact, or it is not safe for you to contact them.
        </div>
      </details>

      {% call form({}) %}
        {{ formSubmitButton({
          text: "Start now",
          isStartButton: true
        }) }}
      {% endcall %}
    </div>

    <div class="govuk-grid-column-one-third">
      {{ gettingHelp(contactEmail) }}
    </div>
  </div>
{% endblock %}
