{% from "govuk/components/phase-banner/macro.njk" import govukPhaseBanner %}
{% from "govuk/components/footer/macro.njk" import govukFooter %}

{% extends "govuk/template.njk" %}

{% block head %}
  {% include "webpack/css.njk" %}
  {% if googleAnalytics and googleAnalytics.enabled %}
    {% include "partials/google-tag-manager-head.njk" %}
  {% endif %}
{% endblock %}

{% block bodyStart %}
  {% if googleAnalytics and googleAnalytics.enabled %}
    {% include "partials/google-tag-manager-body.njk" %}
  {% endif %}

  {% if dynatrace and dynatrace.enabled %}
    {% include "partials/dynatrace.njk" %}
  {% endif %}
{% endblock %}

{% block header %}
  {% include "macros/cookie-banner.njk" %}
  {{ govukHeader({
    homepageUrl: "/",
    containerClasses: "govuk-width-container"
  }) }}
  {{ govukServiceNavigation({
    serviceName: "Dividing your money and property",
    serviceUrl: "/",
    navigation: [
      {
        href: "/logout",
        text: "Sign out"
      }
    ]
  }) }}
{% endblock %}

{% block govukFooter %}
  {{ govukFooter({
    meta: {
      items: [
        {
          href: appRoutes.cookies,
          text: "Cookies"
        }
      ]
    }
  }) }}
{% endblock %}

{% block beforeContent %}
  {% set feedbackLinkHtml %}This is a new service – your <a class="govuk-link" href="{{ feedbackSurveyUrl }}" target="_blank" rel="noopener noreferrer" aria-label="provide feedback on this service (opens in a new tab)">feedback</a> will help us to improve it.{% endset %}
  {{ govukPhaseBanner({
    tag: {
      text: "Beta"
    },
    html: feedbackLinkHtml
  }) }}
{% endblock %}

{% block bodyEnd %}
  {# Run JavaScript at end of the <body>, to avoid blocking the initial render. #}
  {% include "webpack/js.njk" %}
{% endblock %}
