{% extends "template.njk" %}

{% set pageTitle = title %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{ title }}</h1>

      <h3 class="govuk-heading-s govuk-!-margin-bottom-1">{{ telephoneHeading }}</h3>
      <p class="govuk-body govuk-!-margin-bottom-0">
        {{ contact.phoneNumber }}<br>
      </p>
      <p class="govuk-body govuk-!-margin-bottom-3">
        <a class="govuk-link" href="{{ contact.callChargesUrl }}" target="_blank" rel="noopener noreferrer">{{ contact.callChargesText }}</a>
      </p>

      <h3 class="govuk-heading-s govuk-!-margin-bottom-1">{{ openingHoursHeading }}</h3>
      <p class="govuk-body govuk-!-margin-bottom-3">
        {{ contact.openingHours }}<br>
      </p>

      <h3 class="govuk-heading-s govuk-!-margin-bottom-1">{{ emailHeading }}</h3>
      <p class="govuk-body govuk-!-margin-bottom-3">
        <a href="mailto:{{ contactEmail or contact.defaultEmail }}" class="govuk-link">{{ contactEmail or contact.defaultEmail }}</a>
      </p>

    </div>
  </div>
{% endblock %}
